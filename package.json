{
  "name": "takazudo-modular-panels",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build",
    "build:with-docs": "pnpm run build && (cd doc && pnpm run build) && cp -r doc/build dist/doc",
    "preview": "zfb preview",
    "doc:dev": "cd doc && pnpm run start",
    "doc:build": "cd doc && pnpm run build",
    "doc:serve": "cd doc && pnpm run serve",
    "doc:clear": "cd doc && pnpm run clear",
    "lint": "eslint components hooks utils data types pages layouts zfb.config.ts --ext .ts,.tsx",
    "lint:fix": "eslint components hooks utils data types pages layouts zfb.config.ts --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\" \"!**/*.{md,mdx}\" \"!node_modules/**\" \"!out/**\" \"!dist/**\" \"!public/**\" \"!__inbox/**\" \"!doc/**\" \"!worktrees/**\" \"!sub-packages/**\" \"!zfb-app/**\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\" \"!**/*.{md,mdx}\" \"!node_modules/**\" \"!out/**\" \"!dist/**\" \"!public/**\" \"!__inbox/**\" \"!doc/**\" \"!worktrees/**\" \"!sub-packages/**\" \"!zfb-app/**\"",
    "format:md": "node sub-packages/md-formatter/src/cli.js --check \"**/*.{md,mdx}\"",
    "format:md:fix": "node sub-packages/md-formatter/src/cli.js --write \"**/*.{md,mdx}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run format:md",
    "check:fix": "pnpm run lint:fix && pnpm run format:fix && pnpm run format:md:fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test tests/e2e.spec.ts",
    "test:smoke:production": "playwright test tests/e2e.spec.ts --config playwright.config.production.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "test:e2e:production": "playwright test --config playwright.config.production.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:builder": "playwright test tests/builder-panel-color-mapping.spec.ts",
    "test:builder:ui": "playwright test tests/builder-panel-color-mapping.spec.ts --ui",
    "b4push": "./scripts/b4push-quick.sh",
    "b4push:full": "./scripts/b4push.sh",
    "b4push:quick": "./scripts/b4push-quick.sh",
    "prepare": "husky",
    "zfb:check": "zfb check",
    "wind:audit": "zfb wind audit --plan build --fail-on error"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "blurhash": "^2.0.5",
    "@takazudo/zfb": "4.3.0",
    "@takazudo/zfb-runtime": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.10.7",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "puppeteer": "^24.34.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "node sub-packages/md-formatter/src/cli.js --write"
    ]
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
